{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postpone:plan-target:v1",
  "title": "PlanTarget v1",
  "description": "제품 도메인 계약. week의 7일 길이 / 월요일 시작은 도메인 검증에서 확인한다.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unassigned"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "day"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "kind",
        "date"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "week"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endExclusiveDate": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "kind",
        "startDate",
        "endExclusiveDate"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "parked"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ]
}
